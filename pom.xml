<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dev7ex</groupId>
    <artifactId>multiworld</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MultiWorld</name>
    <description>World Management for Minecraft</description>
    <url>https://github.com/Dev7ex/MultiWorld</url>

    <modules>
        <module>multiworld-api</module>
        <module>multiworld-paper</module>
    </modules>

    <properties>
        <maven.compiler.source>${project.source.version}</maven.compiler.source>
        <maven.compiler.target>${project.source.version}</maven.compiler.target>

        <project.minecraft.version>1.17</project.minecraft.version>
        <project.source.version>17</project.source.version>
        <project.source.encoding>UTF-8</project.source.encoding>

        <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
        <maven.javadoc.plugin.version>3.8.0</maven.javadoc.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>

        <dependency.adventure.platform.version>4.3.3</dependency.adventure.platform.version>
        <dependency.adventure.api.version>4.17.0</dependency.adventure.api.version>
        <dependency.annotations.version>24.1.0</dependency.annotations.version>
        <dependency.multicommon.version>1.0.0-SNAPSHOT</dependency.multicommon.version>
        <dependency.nbt.version>2.12.0</dependency.nbt.version>
        <dependency.commons.io.version>2.14.0</dependency.commons.io.version>
        <dependency.junit.version>5.11.4</dependency.junit.version>
        <dependency.lombok.version>1.18.34</dependency.lombok.version>
        <dependency.paper.api.version>1.21.4-R0.1-SNAPSHOT</dependency.paper.api.version>
    </properties>

</project>